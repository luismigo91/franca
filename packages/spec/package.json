{
  "name": "@franca/spec",
  "version": "0.1.0",
  "description": "Esquema, tipos y validador de los flujos de Franca (RFC-0001, borrador)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./flow.schema.json": "./flow.schema.json"
  },
  "bin": {
    "franca-validate": "./dist/cli.mjs"
  },
  "files": ["dist", "flow.schema.json", "examples"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "generate": "node scripts/types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node dist/cli.mjs examples/*.json"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
