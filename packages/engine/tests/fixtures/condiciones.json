{
  "specVersion": "0.1",
  "id": "condiciones",
  "name": "condiciones",
  "variables": [
    {
      "name": "vacio",
      "type": "string"
    },
    {
      "name": "edad",
      "type": "number",
      "default": 30
    },
    {
      "name": "etiquetas",
      "type": "json",
      "default": [
        "nuevo",
        "vip"
      ]
    },
    {
      "name": "fecha",
      "type": "date",
      "default": "2026-10-16"
    }
  ],
  "start": "revisar",
  "nodes": [
    {
      "id": "revisar",
      "type": "condition",
      "rules": [
        {
          "when": {
            "any": [
              {
                "variable": "vacio",
                "op": "isSet"
              },
              {
                "variable": "edad",
                "op": "lt",
                "value": 18
              }
            ]
          },
          "next": "fin-menor"
        },
        {
          "when": {
            "variable": "etiquetas",
            "op": "contains",
            "value": "vip"
          },
          "next": "fin-vip"
        },
        {
          "when": {
            "variable": "fecha",
            "op": "gte",
            "value": "2026-01-01"
          },
          "next": "fin-reciente"
        }
      ],
      "else": "fin-otro"
    },
    {
      "id": "fin-menor",
      "type": "end",
      "outcome": "menor"
    },
    {
      "id": "fin-vip",
      "type": "end",
      "outcome": "vip"
    },
    {
      "id": "fin-reciente",
      "type": "end",
      "outcome": "reciente"
    },
    {
      "id": "fin-otro",
      "type": "end",
      "outcome": "otro"
    }
  ]
}
