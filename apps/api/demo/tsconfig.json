{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.mjs", "../test/demo/*.spec.ts"],
  "exclude": ["../test/demo/mjs-modules.d.ts"]
}
