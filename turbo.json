{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@franca/api#dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "PORT",
        "FRANCA_ANTHROPIC_API_KEY",
        "FRANCA_CONVERSATION_COST_LIMIT_USD",
        "FRANCA_SECRET_*",
        "FRANCA_HTTP_SECRET_ORIGINS",
        "FRANCA_HTTP_ALLOWED_DESTINATIONS",
        "NODE_EXTRA_CA_CERTS"
      ]
    },
    "@franca/web#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["FRANCA_API_URL"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@franca/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/api/src/http/api-error.ts",
        "$TURBO_ROOT$/openspec/**",
        "$TURBO_ROOT$/packages/engine/tests/helpers/spec-text.ts"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build", "db:generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@franca/web#test:e2e": {
      "dependsOn": ["^build", "build", "@franca/api#build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "validate": {
      "dependsOn": ["build"]
    }
  }
}
